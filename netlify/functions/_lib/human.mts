// 사람 말투 엔진: AI 티가 나는 표현을 막는 공통 규칙
export const HUMAN_RULES = `[사람이 쓴 것처럼 쓰는 규칙 — 반드시 지킨다]
- 실제 과일 파는 사장님이 휴대폰으로 직접 쓴 글처럼 쓴다. 광고 대행사 문구처럼 쓰지 않는다.
- 문장 길이를 들쭉날쭉하게. 짧은 문장, 조금 긴 문장을 섞는다. 가끔 한 단어짜리 문장도 좋다.
- 구체적인 장면 하나로 시작한다(예: 오늘 아침 상자 열었을 때, 농장 사장님과 통화한 내용). 단, 판매자가 준 사실·사진에 있는 것만.
- 쓰지 말 것: "안녕하세요 여러분", "~를 소개합니다", "지금 바로", "놓치지 마세요", "특별한", "완벽한", "선사합니다", "만나보세요", "~의 정석", "그야말로", "단순한 ~가 아닌", "~뿐만 아니라", 세 개씩 나열하는 수식어, 느낌표 남발, 문단마다 이모지.
- 결론 요약 문단, "마무리하며", "정리하자면" 금지. 할 말 끝나면 그냥 끝낸다.
- 구어체 어미를 섞는다(~했어요, ~더라고요, ~거든요, ~네요). 한 가지 어미만 반복하지 않는다.
- 솔직한 한마디를 하나 넣는다(예: 크기가 아주 고르진 않아요, 초록빛이 남아 있어도 속은 익었어요). 사실일 때만.
- 이모지는 전체에 0~3개. 해시태그는 채널 안내에 있을 때만.
- 판매자 말투 샘플이 주어지면 그 말투(어미·호흡·자주 쓰는 표현)를 따라 쓴다. 샘플의 내용은 베끼지 않는다.`

// 흔한 AI 말버릇이 남았는지 검사 (남았으면 다시 쓰게 한다)
const TELLS = [/안녕하세요[,!\s]*여러분/, /소개(해\s*드립니다|합니다)/, /놓치지\s*마세요/, /지금\s*바로/, /만나보세요/, /선사(합니다|해)/, /그야말로/, /뿐만\s*아니라/, /정리하자면|마무리하며|결론적으로/, /단순(한|히)\s[^.]{0,20}(아닌|아니라)/]
export function aiTells(text: string): string[] {
  const out: string[] = []
  for (const r of TELLS) { const m = text.match(r); if (m) out.push(m[0]) }
  const ex = (text.match(/!/g) || []).length
  if (ex > 6) out.push(`느낌표 ${ex}개`)
  const emo = (text.match(/\p{Extended_Pictographic}/gu) || []).length
  if (emo > 6) out.push(`이모지 ${emo}개`)
  return out
}
